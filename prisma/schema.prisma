// Cameroon Chess Academy Platform - Database Schema
// Phase 1 MVP: User auth, games, tournaments, learning, schools

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & IDENTITY DOMAIN
// ============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          UserRole
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  profile       Profile?
  gamesAsWhite  Game[]    @relation("WhitePlayer")
  gamesAsBlack  Game[]    @relation("BlackPlayer")
  rating        Int       @default(1200)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tournamentParticipants TournamentParticipant[]
  variantRatings         UserVariantRating[]
  puzzleStats            PuzzleUserStats?
  courseProgress         CourseProgress[]
  playerRating           PlayerRating?
  challengesCreated      Challenge[]            @relation("ChallengeCreator")
  challengesReceived     Challenge[]            @relation("ChallengeOpponent")
  placementRuns          PlacementRun[]
  ladderLessons          LadderLessonProgress[]
  ladderExams            LadderExamResult[]
  ladderDiplomas         LadderDiploma[]

  // Placement / auto-rating. New accounts seed at rating 100 with placementRequired = true;
  // a prompt recurs until placement completes once, then the computed rating overwrites this.
  // Admins can flip placementRequired back to true to re-run placement for any user.
  placementRequired    Boolean   @default(true)
  placementCompletedAt DateTime?

  // Club / competition domain (BUILD_PLAN §3.2). `publicNameMode` may only be
  // set to FULL when this user's GuardianConsent is GRANTED — see §4.3.
  publicNameMode  PublicNameMode      @default(INITIAL)
  memberships     ClubMembership[]
  guardianConsent GuardianConsent?
  attendance      SessionAttendance[]
  boardsAsHome    FixtureBoard[]      @relation("BoardHome")
  boardsAsAway    FixtureBoard[]      @relation("BoardAway")
  arbitedFixtures Fixture[]           @relation("FixtureArbiter")

  @@index([email])
  @@index([username])
  @@index([schoolId])
  @@map("users")
}

// Glicko-2 rating state, kept in its own table so the heavily-read `users` row is
// untouched (and the app keeps working even before this table is migrated in).
// `rating` is the precise (float) Glicko rating carried forward game to game;
// `users.rating` mirrors a rounded copy for display.
model PlayerRating {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Float    @default(1200)
  deviation  Float    @default(350)
  volatility Float    @default(0.06)
  updatedAt  DateTime @updatedAt

  @@map("player_ratings")
}

// One placement (auto-rating) attempt. Stores the adaptive-ladder progress and raw
// per-game move data + per-move evals so the estimate can be audited and re-run
// server-side from the admin dashboard. `estimatedRating` is the fused result that
// overwrites the player's rating on COMPLETE.
model PlacementRun {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          PlacementStatus @default(IN_PROGRESS)
  gamesJson       Json? // [{ botId, botElo, color, result, moves, perMove:[{cpLoss,accuracy,complexity}] }]
  estimatedRating Int?
  estimatedRd     Int?
  confidence      Float? // posterior σ at finalize (smaller = more confident)
  triggeredBy     String          @default("self") // "self" | "admin:<adminId>"
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@map("placement_runs")
}

enum PlacementStatus {
  IN_PROGRESS
  COMPLETE
  ABANDONED

  @@map("placement_status")
}

// Admin accounts are entirely separate from player `users`. Seeded with
// mrsinsj48@gmail.com as the un-removable ROOT. A row with an empty passwordHash
// is "pending bootstrap": the first successful login sets the password (this also
// serves as the invite flow for admins ROOT adds).
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @default("")
  role         AdminRole @default(ADMIN)
  addedById    String? // AdminUser.id that invited this admin (null for ROOT seed)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@map("admin_users")
}

enum AdminRole {
  ROOT
  ADMIN

  @@map("admin_role")
}

enum UserRole {
  STUDENT
  COACH
  SCHOOL_ADMIN
  REGIONAL_ADMIN
  NATIONAL_ADMIN
  VOLUNTEER

  @@map("user_role")
}

model Profile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  country              String    @default("CM")
  chessTitle           String?
  avatarUrl            String?
  followerCount        Int       @default(0)
  friendCount          Int       @default(0)
  ratingTrendJson      Json?
  xp                   Int       @default(0)
  lastPuzzleSolvedAt   DateTime?
  puzzleStreakCount    Int       @default(0)
  badges               Badge[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@map("profiles")
}

// ============================================================================
// INSTITUTION DOMAIN
// ============================================================================

model School {
  id          String       @id @default(uuid())
  name        String
  region      String
  // Club-domain additions (BUILD_PLAN §3.2). A school may host more than one club.
  slug        String?      @unique
  kind        SchoolKind   @default(SECONDARY)
  town        String?
  clubs       Club[]
  students    User[]
  tournaments Tournament[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([region])
  @@map("schools")
}

enum SchoolKind {
  SECONDARY
  UNIVERSITY

  @@map("school_kind")
}

// ============================================================================
// GAME DOMAIN
// ============================================================================

model Game {
  id             String        @id @default(uuid())
  whiteId        String
  blackId        String
  white          User          @relation("WhitePlayer", fields: [whiteId], references: [id], onDelete: Cascade)
  black          User          @relation("BlackPlayer", fields: [blackId], references: [id], onDelete: Cascade)
  moves          String        @db.Text // PGN or JSON format
  result         GameResult?
  status         GameStatus    @default(PENDING)
  timeControl    String        // e.g., "10+0", "30+0"
  rated          Boolean       @default(true) // false = casual: no rating change
  whiteRating    Int?          // each player's rating snapshot when the game was created
  blackRating    Int?
  analysisJson   Json?
  tournamentId   String?
  tournament     Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  gameXpAwards   GameXpAward[]
  challenge      Challenge?
  // Club-domain additions (BUILD_PLAN §3.2). `validationState != NOT_REQUIRED`
  // is the signal the `cca` game server uses to SKIP its own rating write
  // (§4.4) — a fixture board is rated once, at arbiter validation.
  source          GameSource      @default(ONLINE)
  validationState ValidationState @default(NOT_REQUIRED)
  clubContextId   String?       // set for club-ladder games
  // Back-relation only. FixtureBoard.gameId is the canonical side of the link;
  // there is deliberately no `fixtureBoardId` column on games.
  fixtureBoard    FixtureBoard?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([whiteId])
  @@index([blackId])
  @@index([status])
  @@index([tournamentId])
  @@map("games")
}

model GameXpAward {
  id        String   @id @default(uuid())
  gameId    String
  userId    String
  awardedAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@map("game_xp_awards")
}

// A challenge / invite. A direct challenge names an opponent; an open one
// (opponentId null) is a shareable invite link anyone signed-in can accept.
// On accept, a Game is created and linked via gameId.
model Challenge {
  id           String          @id @default(uuid())
  creatorId    String
  creator      User            @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponentId   String?
  opponent     User?           @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  creatorColor String          // "white" | "black" | "random"
  timeControl  String
  rated        Boolean         @default(true)
  status       ChallengeStatus @default(OPEN)
  gameId       String?         @unique
  game         Game?           @relation(fields: [gameId], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([creatorId])
  @@index([opponentId])
  @@index([status])
  @@map("challenges")
}

enum ChallengeStatus {
  OPEN
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("challenge_status")
}

enum GameStatus {
  PENDING
  ACTIVE
  COMPLETED
  ABANDONED

  @@map("game_status")
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  STALEMATE

  @@map("game_result")
}

enum GameSource {
  ONLINE
  OTB

  @@map("game_source")
}

enum ValidationState {
  NOT_REQUIRED
  PENDING
  VALIDATED
  DISPUTED

  @@map("validation_state")
}

enum PublicNameMode {
  INITIAL
  FULL

  @@map("public_name_mode")
}

// ============================================================================
// TOURNAMENT DOMAIN
// ============================================================================

model Tournament {
  id               String                  @id @default(uuid())
  name             String
  schoolId         String
  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  startDate        DateTime
  endDate          DateTime?
  status           TournamentStatus        @default(UPCOMING)
  chessVariant     String                  @default("Blitz")
  arenaTimeControl String                  @default("3+0")
  format           String                  @default("ARENA")
  maxPlayers       Int                     @default(450)
  durationMinutes  Int                     @default(60)
  cardColor        String                  @default("blue")
  isSponsored      Boolean                 @default(false)
  isRated          Boolean                 @default(true)
  iconType         String?
  prizePoolJson    Json?
  // Professional-tournament engine (all additive; existing school-scoped, arena
  // tournaments keep working). `format` stays a String: ARENA | SWISS | ROUND_ROBIN | KNOCKOUT.
  totalRounds         Int? // planned rounds for SWISS/ROUND_ROBIN/KNOCKOUT (null = arena/open)
  currentRound        Int               @default(0)
  tiebreak            String            @default("BUCHHOLZ") // BUCHHOLZ | SONNEBORN_BERGER | NONE
  registrationOpensAt DateTime?
  checkInRequired     Boolean           @default(false)
  rounds              TournamentRound[]
  games            Game[]
  participants     TournamentParticipant[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([schoolId])
  @@index([status])
  @@index([startDate])
  @@map("tournaments")
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED

  @@map("tournament_status")
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Float      @default(0)
  // Pairing + tiebreak state (additive).
  colorHistory    String[] @default([]) // ["w","b",...] for color balancing
  opponentIds     String[] @default([]) // userIds already faced (no-repeat in Swiss)
  byes            Int      @default(0)
  checkedIn       Boolean  @default(false)
  withdrawn       Boolean  @default(false)
  buchholz        Float    @default(0)
  sonnebornBerger Float    @default(0)
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@map("tournament_participants")
}

// A round of a SWISS / ROUND_ROBIN / KNOCKOUT tournament (Arena is round-less).
model TournamentRound {
  id           String              @id @default(uuid())
  tournamentId String
  tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int
  status       RoundStatus         @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  pairings     TournamentPairing[]
  createdAt    DateTime            @default(now())

  @@unique([tournamentId, number])
  @@index([tournamentId])
  @@map("tournament_rounds")
}

// One board: white vs black (blackUserId null = a bye). `gameId` links the live game.
model TournamentPairing {
  id           String          @id @default(uuid())
  roundId      String
  round        TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  tournamentId String // denormalized for cheap per-tournament queries
  boardNumber  Int             @default(1)
  whiteUserId  String?
  blackUserId  String? // null = bye for whiteUserId
  gameId       String?
  result       String? // "1-0" | "0-1" | "1/2-1/2" | "bye"
  createdAt    DateTime        @default(now())

  @@index([roundId])
  @@index([tournamentId])
  @@map("tournament_pairings")
}

enum RoundStatus {
  PENDING
  ONGOING
  COMPLETED

  @@map("round_status")
}

// ============================================================================
// LEARNING DOMAIN
// ============================================================================

model Puzzle {
  id         String   @id @default(uuid())
  fen        String   // Chess position in FEN notation
  solution   String   // Move sequence (e.g., "e2e4 e7e5")
  difficulty Int      @default(1200)
  theme      String[] // e.g., ["fork", "pin", "checkmate"]
  createdAt  DateTime @default(now())

  @@index([difficulty])
  @@map("puzzles")
}

model Badge {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String
  earnedAt    DateTime @default(now())

  @@index([profileId])
  @@map("badges")
}

// ============================================================================
// CHESS.PRO EXTENSIONS: ratings, metrics, learn progress
// ============================================================================

enum ChessVariant {
  ULTRABULLET
  BULLET
  BLITZ
  RAPID
  CLASSIC
  CRAZYHOUSE
  CHESS960
  KOTH
  THREECHECK
  ANTICHESS
  ATOMIC
  HORDE
  RACING_KINGS

  @@map("chess_variant")
}

model UserVariantRating {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant      ChessVariant
  rating       Int          @default(1200)
  ratingDelta  Int          @default(0)
  gamesPlayed  Int          @default(0)

  @@unique([userId, variant])
  @@index([userId])
  @@map("user_variant_ratings")
}

model PuzzleUserStats {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodDays          Int      @default(30)
  solvedCount         Int      @default(0)
  performanceRating   Int    @default(1800)
  successRate         Float    @default(0)
  radarSkillsJson     Json
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@map("puzzle_user_stats")
}

model PlatformMetric {
  id        String   @id @default(uuid())
  key       String   @unique
  intValue  Int?
  strValue  String?
  updatedAt DateTime @updatedAt

  @@map("platform_metrics")
}

model Course {
  id          String           @id @default(uuid())
  slug        String           @unique
  title       String
  category    String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  progress    CourseProgress[]

  @@index([category])
  @@map("courses")
}

model CourseProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  bookmarked  Boolean  @default(false)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_progress")
}

// ============================================================================
// THE LADDER — a student's progress through the Android app's tiered curriculum
// ============================================================================
//
// Not `CourseProgress`, which is above and stays where it is. That model is the
// legacy website's per-course completed/bookmarked flag, keyed on a `Course`
// row, and it cannot carry what the app needs: the app's curriculum is eleven
// Elo-banded tiers of individual lessons, drills, exams and diplomas, and its
// unit of progress is a lesson, not a course.
//
// ── Why these three tables and not the app's six ─────────────────────────
//
// The phone keeps more than this. It also holds every drill attempt, the
// spaced-repetition schedule and the Woodpecker cycle counters — thousands of
// rows for an active student, all of it training exhaust that is only ever
// read by the device that wrote it. Pushing that over a school's 3G to be
// stored per user would cost real money and buy nothing a student would
// notice.
//
// What a student WOULD notice is signing in on a new phone and finding their
// ladder reset. That is these three: which lessons are finished, which exams
// were sat, and which tiers are sealed. Attempts and review schedules stay on
// the device and rebuild themselves through use.
//
// ── Everything here only ever accumulates ────────────────────────────────
//
// A lesson finished anywhere is finished; a sitting is a fact; a diploma is
// the best sitting so far. No operation in this domain removes progress, which
// is what lets two phones sync without a conflict protocol — see
// `domains/learning/ladder.ts`, where every merge rule is a tested
// function.
//
// ── Private, and only to its owner ───────────────────────────────────────
//
// A study record belongs to the student it is about, most of whom are minors.
// There is no resolver that reads another person's progress and there must not
// be one added casually: a patron seeing their students' work is a real want
// and a guardian-consent decision (BUILD_PLAN §4.3), not a query to slip in.

enum LadderExamGrade {
  FAIL
  PASS
  GOOD
  EXCELLENT

  @@map("ladder_exam_grade")
}

/// One lesson, finished. The spine of the ladder: ~220 rows for a student who
/// completes every tier, and the only thing the map needs to draw itself.
model LadderLessonProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The app's own lesson slug, e.g. `coord-guard`. Opaque here on purpose —
  /// the curriculum ships in the app, and a server that validated these
  /// against a list would need redeploying every time a tier gained a lesson.
  lessonId    String
  tierId      String

  /// Kept at the EARLIEST claim. A lesson finished in March on a phone since
  /// lost was not finished again in September on a new one.
  completedAt DateTime

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("ladder_lesson_progress")
}

/// One sat exam. Append-only: a sitting is something that happened, and the
/// history is what makes a re-sit visible.
model LadderExamResult {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Generated on the device, and the reason a retried push is not a second
  /// sitting. The phone may be offline for a week and flush the same queue
  /// twice; this is what makes that harmless.
  attemptId   String

  examId      String
  tierId      String

  /// What the student scored, and what the paper was worth. The only two
  /// numbers taken on trust — an offline app is the sole witness to its own
  /// exam — and everything below is derived from them by the server.
  scorePoints Int
  maxPoints   Int

  /// Derived, never accepted: `percentFor` and `gradeFor` in
  /// `domains/learning/ladder.ts`. Yusupov's bands, which the app's exams
  /// use verbatim — under 60 fails, 60-74 passes, 75-89 good, 90+ excellent.
  percent     Int
  grade       LadderExamGrade

  startedAt   DateTime
  finishedAt  DateTime

  /// Server clock, for support questions the two above cannot answer — such as
  /// a sitting dated last March that arrived this morning.
  recordedAt  DateTime        @default(now())

  @@unique([userId, attemptId])
  @@index([userId, tierId])
  @@map("ladder_exam_results")
}

/// A tier's seal. One per tier per student, holding their best sitting.
///
/// Derived from a passing `LadderExamResult` in the same transaction rather
/// than pushed by the client, so the seal and the sitting that earned it can
/// never disagree. Kept as a row rather than computed on read because the
/// product treats it as an award — it is dated, it is displayed, and it is
/// printed at the club.
model LadderDiploma {
  id       String          @id @default(uuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId   String

  /// The best percentage this student has passed the tier with. A later,
  /// worse sitting never lowers it — see `improvesDiploma`.
  percent  Int
  grade    LadderExamGrade

  /// When it was earned, not when it was last matched: a tie on percentage
  /// keeps the earlier date.
  earnedAt DateTime

  @@unique([userId, tierId])
  @@index([userId])
  @@map("ladder_diplomas")
}

// ============================================================================
// COMMUNITY / ACTIVITIES DOMAIN — events, recaps, articles, galleries
// ============================================================================

// A community post: announcement, event recap, article/blog, photo gallery, or
// result roundup. Authored in the admin (Tiptap rich body), displayed in the
// community feed + landing preview. Media: cover/images in Supabase Storage,
// video via an embed URL (YouTube/Vimeo).
model Activity {
  id            String          @id @default(uuid())
  slug          String          @unique
  type          ActivityType    @default(ARTICLE)
  title         String
  excerpt       String? // short summary for cards
  bodyJson      Json? // Tiptap document JSON (authoring source of truth)
  bodyText      String?         @db.Text // plain-text rendering (search / fallback / SEO)
  coverImageUrl String?
  videoEmbedUrl String? // YouTube/Vimeo embed
  region        String? // Cameroon region (Centre, Littoral, Sud-Ouest, …) — null = national
  tags          String[]        @default([])
  status        ActivityStatus  @default(DRAFT)
  featured      Boolean         @default(false) // hero slot in the feed / landing
  authorAdminId String? // AdminUser.id that wrote it
  eventDate     DateTime? // for event-type posts (the date the event happened/happens)
  publishedAt   DateTime?
  // Club news feed (BUILD_PLAN §3.2). null = academy-level post.
  clubId        String?
  club          Club?           @relation(fields: [clubId], references: [id], onDelete: SetNull)
  images        ActivityImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([type])
  @@index([featured])
  @@index([clubId])
  @@map("activities")
}

model ActivityImage {
  id         String   @id @default(uuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  url        String // display rendition (~1800px long edge)
  thumbUrl   String? // grid/collage rendition (~640px long edge)
  width      Int? // display-rendition pixel size, for zero-CLS masonry layout
  height     Int?
  highlight  Boolean  @default(false) // curated subset shown on landing/feed collages
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([activityId])
  @@index([activityId, highlight])
  @@map("activity_images")
}

enum ActivityType {
  ANNOUNCEMENT
  EVENT_RECAP
  ARTICLE
  GALLERY
  RESULT

  @@map("activity_type")
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("activity_status")
}
// ============================================================================
// CLUB / SEASON / COMPETITION DOMAIN — BUILD_PLAN §3.1
// ----------------------------------------------------------------------------
// School = the institution. Club = the chess club inside it (a school may host
// more than one). Season = the academic-year container. Division = a league
// group inside a season, named after its catchment, never a bare region name.
// Zone = one of four groupings of divisions feeding the zonal finals. Region =
// one of Cameroon's ten administrative regions, a canonical key like
// SOUTH_WEST. Fixture = a team match across N boards. Game = one chess game.
//
// Additive only. Nothing above this line is renamed or dropped.
// ============================================================================

// ─── INSTITUTION ────────────────────────────────────────────────────────────

model Club {
  id        String     @id @default(uuid())
  slug      String     @unique // "gbhs-limbe"
  name      String // "GBHS Limbe Chess Club"
  shortName String // "GL" — 2–3 chars, drives the crest
  /// NULL for an independent club — one with no host institution. A chess club
  /// can be a school's or a town's, and this column is the single source of
  /// truth for which: `Club.kind` on the GraphQL type is DERIVED from it and is
  /// deliberately not stored, because a second writable column beside this one
  /// would be a second source of truth for one fact, free to drift.
  ///
  /// `onDelete: Restrict` stays. SET NULL only becomes expressible once the
  /// column is nullable, and deleting a school would then silently orphan its
  /// clubs with no audit trail.
  schoolId  String?
  school    School?    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  region    String // canonical key, e.g. "SOUTH_WEST"
  /// The HOST INSTITUTION's education stage, denormalised from `School.kind`
  /// (see scripts/onboard-clubs.ts) — it was never the club's own attribute.
  /// Meaningless for an independent club, which has no institution and so no
  /// stage: it is never rendered for one, and `clubs(level:)` scopes itself to
  /// clubs that have a school. Deliberately NOT nullable — `Club.level` is
  /// `ClubLevel!` in the SDL and ccapp coerces it on devices that cannot be
  /// redeployed atomically, so relaxing it is a breaking output change.
  level     ClubLevel  @default(SECONDARY)
  crestJson Json? // { shield, band, charge } — see BUILD_PLAN §5
  status    ClubStatus @default(ONBOARDING)
  joinCode  String     @unique // NEVER exposed on a public GraphQL type
  foundedOn DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships   ClubMembership[]
  sessions      ClubSession[]
  divisionSpots DivisionEntry[]
  honours       ClubHonour[]
  activities    Activity[]
  homeFixtures  Fixture[]        @relation("HomeClub")
  awayFixtures  Fixture[]        @relation("AwayClub")

  @@index([region])
  @@index([status])
  @@index([schoolId])
  @@map("clubs")
}

enum ClubLevel {
  SECONDARY
  UNIVERSITY

  @@map("club_level")
}

/// Whether a club is hosted by an institution or stands on its own.
///
/// Deliberately a SEPARATE axis from `ClubLevel`, not a third value on it:
/// level is the host institution's education stage, and a club with no host
/// has no stage. Conflating them would make "has no school" a type-legal value
/// for `Division.level`, where it is meaningless.
///
/// On `Club` this is DERIVED from `schoolId IS NULL` and never stored. It is
/// stored only on `SchoolEnquiry`, which has no school to derive from.
enum ClubKind {
  SCHOOL
  INDEPENDENT

  @@map("club_kind")
}

enum ClubStatus {
  ONBOARDING
  ACTIVE
  DORMANT
  ARCHIVED

  @@map("club_status")
}

// A person's link to one club, with a role and a status. Authorization checks
// that touch club data read this, never `User.role` alone. Exactly ONE ACTIVE
// membership per user — enforced by a partial unique index that Prisma cannot
// express, so it lives in prisma/manual_apply_clubs_seasons.sql (BUILD_PLAN §2).
model ClubMembership {
  id         String           @id @default(uuid())
  clubId     String
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MembershipRole   @default(PLAYER)
  status     MembershipStatus @default(PENDING)
  schoolYear String? // "Form 4", "Upper Sixth", "L2"
  boardOrder Int? // A-team board 1–4, null = not selected
  joinedAt   DateTime         @default(now())
  leftAt     DateTime?

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId, status])
  @@map("club_memberships")
}

enum MembershipRole {
  PLAYER
  CAPTAIN
  PATRON
  ASSISTANT_COACH

  @@map("membership_role")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  LEFT
  REMOVED

  @@map("membership_status")
}

// Club trophies and titles. Player honours reuse the existing `Badge` model.
model ClubHonour {
  id        String     @id @default(uuid())
  clubId    String
  club      Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  seasonId  String?
  season    Season?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  title     String // "Limbe Inter-Schools Rapid — Champions"
  kind      HonourKind @default(TROPHY)
  awardedOn DateTime

  @@index([clubId])
  @@map("club_honours")
}

enum HonourKind {
  TROPHY
  TITLE
  PROMOTION
  MILESTONE

  @@map("honour_kind")
}

// ─── SEASON & COMPETITION ───────────────────────────────────────────────────

model Season {
  id        String       @id @default(uuid())
  slug      String       @unique // "2026-27"
  name      String // "2026/27"
  startsOn  DateTime
  endsOn    DateTime
  status    SeasonStatus @default(PLANNED)
  divisions Division[]
  fixtures  Fixture[]
  honours   ClubHonour[]

  @@map("seasons")
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  ARCHIVED

  @@map("season_status")
}

model Division {
  id             String    @id @default(uuid())
  seasonId       String
  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name           String // "Fako & Meme" — never a bare region name
  zone           String // "COASTAL" — one of four
  regions        String[]  @default([]) // canonical region keys in this division's catchment
  level          ClubLevel @default(SECONDARY)
  totalMatchDays Int       @default(14)

  entries  DivisionEntry[]
  fixtures Fixture[]

  @@unique([seasonId, name, level])
  @@index([seasonId])
  @@map("divisions")
}

// A club's place in a division. Derived from VALIDATED fixtures — never hand-edited.
// `position` and `previousPosition` are written by the same recompute, so the
// public table can show movement without a separate history table.
model DivisionEntry {
  id               String   @id @default(uuid())
  divisionId       String
  division         Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  played           Int      @default(0)
  won              Int      @default(0)
  drawn            Int      @default(0)
  lost             Int      @default(0)
  byes             Int      @default(0)
  matchPoints      Int      @default(0) // 3 / 1 / 0
  boardPoints      Float    @default(0) // halves are real
  position         Int?
  previousPosition Int?
  formJson         Json? // ["W","W","D","W"] most-recent-last

  @@unique([divisionId, clubId])
  @@index([divisionId])
  @@map("division_entries")
}

// A team match. Both club references are NULLABLE, deliberately:
//   • a bye             → awayClubId null, boardCount 0, status VALIDATED
//   • a cup placeholder → both null until the feeding ties resolve; the bracket
//                         renders `homeSourceLabel` / `awaySourceLabel` instead
model Fixture {
  id              String         @id @default(uuid())
  seasonId        String
  season          Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  divisionId      String?
  division        Division?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  competition     Competition    @default(DIVISION)
  stage           CupStage?
  matchDay        Int?
  homeClubId      String?
  homeClub        Club?          @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: Restrict)
  awayClubId      String?
  awayClub        Club?          @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: Restrict)
  homeSourceLabel String? // "Winner QF1" — bracket placeholder
  awaySourceLabel String?
  isBye           Boolean        @default(false)
  scheduledAt     DateTime
  venue           String?
  boardCount      Int            @default(4)
  status          FixtureStatus  @default(SCHEDULED)
  homeScore       Float          @default(0) // board points, derived — never entered
  awayScore       Float          @default(0)
  arbiterId       String?
  arbiter         User?          @relation("FixtureArbiter", fields: [arbiterId], references: [id], onDelete: SetNull)
  validatedById   String?
  validatedAt     DateTime?
  boards          FixtureBoard[]
  events          FixtureEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([seasonId, scheduledAt])
  @@index([divisionId, matchDay])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([status])
  @@map("fixtures")
}

enum Competition {
  DIVISION
  CUP
  ZONAL_FINAL
  NATIONAL_FINAL
  FRIENDLY

  @@map("competition")
}

enum CupStage {
  R32
  R16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL

  @@map("cup_stage")
}

enum FixtureStatus {
  SCHEDULED
  TEAM_SHEETS
  LIVE
  AWAITING_VALIDATION
  VALIDATED
  CANCELLED

  @@map("fixture_status")
}

// One board of a fixture. `result` uses the SAME enum as Game — one encoding,
// no mapping layer. `homeColor` is what lets a display render it White-first.
// `gameId` is set only when moves exist to store: always for ONLINE boards,
// for OTB boards only if someone digitises the scoresheet. Ratings and career
// ledgers read FixtureBoard, never Game, so a moveless OTB board still counts.
model FixtureBoard {
  id            String      @id @default(uuid())
  fixtureId     String
  fixture       Fixture     @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  boardNumber   Int
  homeUserId    String?
  homeUser      User?       @relation("BoardHome", fields: [homeUserId], references: [id], onDelete: SetNull)
  awayUserId    String?
  awayUser      User?       @relation("BoardAway", fields: [awayUserId], references: [id], onDelete: SetNull)
  homeColor     PieceColor  @default(WHITE)
  source        GameSource  @default(OTB)
  gameId        String?     @unique
  game          Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  result        GameResult?
  scoresheetUrl String?
  moveCount     Int?
  recordedById  String?
  recordedAt    DateTime?
  ratedAt       DateTime? // set once, at validation — guards double-rating

  @@unique([fixtureId, boardNumber])
  @@index([fixtureId])
  @@map("fixture_boards")
}

enum PieceColor {
  WHITE
  BLACK

  @@map("piece_color")
}

// The live-coverage timeline on a fixture page. Written by result entry and
// validation; readable publicly.
model FixtureEvent {
  id         String    @id @default(uuid())
  fixtureId  String
  fixture    Fixture   @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  kind       EventKind
  board      Int?
  message    String
  occurredAt DateTime  @default(now())

  @@index([fixtureId, occurredAt])
  @@map("fixture_events")
}

enum EventKind {
  MATCH_START
  BOARD_RESULT
  VALIDATED
  NOTE

  @@map("event_kind")
}

// ─── CLUB LIFE ──────────────────────────────────────────────────────────────

model ClubSession {
  id       String        @id @default(uuid())
  clubId   String
  club     Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title    String
  startsAt DateTime
  location String?
  planJson Json?
  status   SessionStatus @default(SCHEDULED)

  attendance SessionAttendance[]

  @@index([clubId, startsAt])
  @@map("club_sessions")
}

enum SessionStatus {
  SCHEDULED
  HELD
  CANCELLED

  @@map("session_status")
}

model SessionAttendance {
  id        String          @id @default(uuid())
  sessionId String
  session   ClubSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     AttendanceState @default(ABSENT)
  markedAt  DateTime        @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("session_attendance")
}

enum AttendanceState {
  PRESENT
  EXCUSED
  ABSENT

  @@map("attendance_state")
}

// ─── SAFEGUARDING ───────────────────────────────────────────────────────────

// Consent gates DISPLAY, not participation (BUILD_PLAN §3.3 #5 / §4.3). A player
// with pending consent still plays, still rates and still appears in standings —
// as "Brenda A.". Unknown age, or no Profile at all, is treated as a minor.
model GuardianConsent {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          ConsentStatus  @default(PENDING)
  method          ConsentMethod?
  guardianName    String?
  guardianContact String?
  countersignedBy String?
  requestedAt     DateTime       @default(now())
  decidedAt       DateTime?

  @@index([status])
  @@map("guardian_consents")
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
  WITHDRAWN

  @@map("consent_status")
}

enum ConsentMethod {
  SMS
  WHATSAPP
  PAPER
  EMAIL

  @@map("consent_method")
}

// ─── INTAKE ─────────────────────────────────────────────────────────────────

model SchoolEnquiry {
  id           String        @id @default(uuid())
  /// The organisation's name: the school for a SCHOOL enquiry, the club's own
  /// name for an INDEPENDENT one. The column name is shipped; only the label
  /// the enquirer reads changed.
  schoolName   String
  town         String?
  region       String
  /// STORED here, unlike on `Club`. An enquiry has no foreign key — only a
  /// typed-in name — so there is nothing to derive the kind from.
  kind         ClubKind      @default(SCHOOL)
  /// NULL for an independent enquiry: no school, no education stage. The old
  /// `@default(SECONDARY)` filed every school-less enquiry as a secondary
  /// school.
  level        ClubLevel?
  sizeBand     String?
  contactName  String
  contactRole  String?
  contactPhone String
  contactEmail String?
  note         String?
  wantsFrench  Boolean       @default(false)
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
  @@map("school_enquiries")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  MEETING_BOOKED
  SIGNED
  DECLINED

  @@map("enquiry_status")
}

// Rate-limit ledger for the PUBLIC `submitSchoolEnquiry` mutation (BUILD_PLAN §6).
// Vercel serverless has no shared memory, so an in-process counter is useless —
// every invocation may be a cold container. The throttle therefore lives in the
// database: one row per (scope, key) with a rolling window.
//
// `key` is a SHA-256 of the IP or of the normalised phone number, never the raw
// value: this table exists to say "too many", not to build a log of who tried.
model EnquiryThrottle {
  id              String   @id @default(uuid())
  scope           String // "IP" | "PHONE"
  key             String // sha256(value) — never the raw IP or phone
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@unique([scope, key])
  @@index([windowStartedAt])
  @@map("enquiry_throttle")
}
