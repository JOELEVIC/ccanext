# Database (PostgreSQL - Supabase supported)
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:6543/postgres?pgbouncer=true

# JWT
JWT_SECRET=your-32-character-minimum-secret-key-here
JWT_EXPIRES_IN=7d

# Supabase (required for config validation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# CORS (ccaui origin)
CORS_ORIGIN=http://localhost:3000

# Google sign-in — the OAuth client ids whose ID tokens loginWithGoogle accepts
# as `aud`, comma separated. OPTIONAL: leave it unset and the API falls back to
# the single hardcoded web client, which is how it behaved before this variable
# existed, and which is all Android needs (the app passes the web client id as
# serverClientId, and that is what lands in `aud`).
#
# Set it when iOS ships: iOS mints tokens against the iOS client id, so iOS
# sign-in fails until that id is listed here alongside the web one.
#
# These ids are public — they ship inside the browser bundle and the mobile
# binaries — so this is configuration, not a secret. It is still the line to be
# careful with: EVERY id here must belong to the SAME Google Cloud project.
# `aud` names the OAuth client that asked for the token, so an id borrowed from
# an unrelated project makes that project's consent screen a way to mint tokens
# this API will accept as a CCA identity. Matching is exact; a blank entry
# between two commas is dropped rather than allowed to match an empty `aud`.
# GOOGLE_CLIENT_IDS=649457496601-web....apps.googleusercontent.com,649457496601-ios....apps.googleusercontent.com
